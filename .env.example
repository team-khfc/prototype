# DB role 이름은 이미 병합된 Flyway의 권한 호환을 위해 boan_app/boan_migrator를 유지합니다.
# python3 scripts/init-demo.py가 로컬 비밀값을 생성합니다. 실제 값을 이 파일에 넣지 마세요.
SA_DB_USER=boan_app
SA_DB_PASSWORD=
SA_MIGRATION_USER=boan_migrator
SA_MIGRATION_PASSWORD=
SA_DB_URL=jdbc:postgresql://localhost:5432/securityadvisor
SA_CONTEXT_KEY=
SA_DEMO_ENABLED=true
SA_DEMO_APPLICANT_PASSWORD=
SA_DEMO_SECURITY_PASSWORD=
SA_DEMO_INFRA_PASSWORD=
SA_DEMO_ADMIN_PASSWORD=
SA_OPENAI_API_KEY=
SA_GEMMA_API_KEY=
SA_ALLOWED_LLM_ENDPOINTS=https://api.openai.com/v1/chat/completions,https://generativelanguage.googleapis.com/v1beta/models/gemma-4-26b-a4b-it:generateContent
SA_WEB_PORT=3000
SA_API_PORT=8080
SA_DB_PORT=5432

