            "minLength": 1,
            "pattern": "TCP|UDP|ICMP"
          },
          "direction": {
            "type": "string",
            "minLength": 1,
            "pattern": "ONE_WAY|BIDIRECTIONAL"
          },
          "startsOn": {
            "type": "string",
            "format": "date"
          },
          "endsOn": {
            "type": "string",
            "format": "date"
          },
          "purpose": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "destinationIp",
